CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_AUDIO_DECODER_G722_SUPPORT=y
CONFIG_AUDIO_ENCODER_G722_SUPPORT=y
# CONFIG_ESP_COREDUMP_CHECK_BOOT is not set
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Boot-time fixed gain for the 48 kHz PDM pair. 16x is the shipped default for
# the current MEMS sensitivity; the 20 mm array itself contributes no gain.
# Tune it from the capture telemetry, not by ear: audio.capture_health reports
# rms_dbfs_l/r, l_clip and r_clip per five-second window. Keep speech RMS above
# -45 dBFS and clipping at 0; if a unit measures below -45 dBFS at 1x, use 4x
# before going higher.
CONFIG_MIC_OUTPUT_GAIN_X=8

# Bounded 5-second resource sampling; no all-task enumeration/formatting.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U32=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# Internal RAM is the scarce resource on this board (PDM + LCD + ESP-NOW +
# USB Serial/JTAG).  ESP-NOW carries 400 B at 50 fps, so the default Wi-Fi
# buffer pools are larger than needed.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4